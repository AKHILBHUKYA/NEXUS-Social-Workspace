# Local development
DB_URL=jdbc:h2:mem:nexus;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api

# Optional AI provider
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Official social provider credentials
SOCIAL_META_CLIENT_ID=
SOCIAL_META_CLIENT_SECRET=
SOCIAL_META_GRAPH_VERSION=v23.0
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_X_SCOPES=tweet.read tweet.write users.read offline.access
SOCIAL_WHATSAPP_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=replace-with-random-token
