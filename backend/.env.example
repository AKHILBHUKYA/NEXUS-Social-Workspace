PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/nexus
DB_USERNAME=nexus
DB_PASSWORD=change_me
DB_DRIVER=org.postgresql.Driver
DDL_AUTO=validate
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000
FRONTEND_URL=http://localhost:5173
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Real social integrations (official APIs; credentials come from your developer apps)
BACKEND_URL=http://localhost:8080
SOCIAL_META_CLIENT_ID=
SOCIAL_META_CLIENT_SECRET=
SOCIAL_META_GRAPH_VERSION=v23.0
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_X_SCOPES=tweet.read tweet.write users.read offline.access
SOCIAL_REDIRECT_PATH=/api/social/callback
SOCIAL_WHATSAPP_PHONE_NUMBER_ID=

META_WEBHOOK_VERIFY_TOKEN=replace-with-random-webhook-token
